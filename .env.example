# Walmart Connect (WMC) Display Ads API — Campaign Manager POC
# Simulated mode (default) uses an in-memory WMC sandbox; no external calls.
# For live mode set WMC_SIMULATE=false and provide ALL of the credentials
# below together — per Walmart's Partner Operating Guide, live requests
# require the bearer token AND the RSA signature at the same time, not
# either/or. The UI can also pass a per-user advertiser ID + access token
# per request.
WMC_SIMULATE=true
# Display API base host + path from your partner onboarding pack. Confirmed
# Display SANDBOX base (note the doubled /api/v1 — staging bakes one into
# the base itself, then each route below appends its own /api/v1/<endpoint>):
# WMC_ADS_API_URL=https://developer.api.us.stg.walmart.com/api-proxy/service/display/api/v1
# WMC_ADVERTISER_ID=
# Plain bearer token issued alongside your Consumer ID — sent as
# Authorization: Bearer <token>. It plays no part in the signature below.
# WMC_ACCESS_TOKEN=

# Consumer-signature auth (WM_SEC.AUTH_SIGNATURE) — RSA-SHA256 over
# "<consumerId>\n<timestamp>\n<keyVersion>\n". You generate this RSA keypair
# yourself via openssl; only the PUBLIC key is uploaded to the Partner
# Onboarding Hub, which is what causes Walmart to issue the Consumer
# ID/access token/key version above. WMC_PRIVATE_KEY is the PEM contents of
# the private half — a different secret from the access token, never sent
# to Walmart, required to compute the signature. When pasting a multi-line
# PEM into this file, wrap it in double quotes and keep the real newlines:
#   WMC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----"
# WMC_CONSUMER_ID=
# WMC_KEY_VERSION=1
# WMC_PRIVATE_KEY=

# Product lookup for the "enter a SKU" creative step — the Marketplace Items
# API (seller item management), a separate Walmart API surface from Display
# Ads. Auth is a pre-obtained access token, not the RSA signature above.
# Leave unset for the simulated catalog (deterministic SVG placeholder images).
# WMC_PRODUCT_API_URL=https://marketplace.walmartapis.com
# WMC_PRODUCT_ACCESS_TOKEN=
# WMC_PRODUCT_SVC_NAME=
